APP_NAME=SPRY Task Management API
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4200

# Added during the database phase. Never commit real credentials.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spry_task_management

# Added during the authentication phase.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7

# In-memory request throttling for the current single-worker deployment.
RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT=100/minute
LOGIN_RATE_LIMIT=5/15minutes
REFRESH_RATE_LIMIT=20/minute
LOGOUT_RATE_LIMIT=10/minute
TASK_WRITE_RATE_LIMIT=30/minute
